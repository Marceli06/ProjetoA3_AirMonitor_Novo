# Copie para .env no desenvolvimento ou configure no painel da Vercel. NUNCA versione o .env.
# URL base da API do backend, terminando em /api. Sem ela, o desenvolvimento usa http://localhost:3000/api.
# Produção (exemplo): https://airmonitor-api.onrender.com/api
VITE_API_URL=http://localhost:3000/api

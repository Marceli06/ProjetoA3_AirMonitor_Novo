# Copie para .env e preencha. NUNCA versione o .env.
DATABASE_URL=
JWT_SECRET=
PORT=3000
NODE_ENV=development

# Chave da API OpenAQ v3 (https://explore.openaq.org). Enviada somente pelo backend, no header X-API-Key.
OPENAQ_API_KEY=

# Opcionais (valores padrão entre parênteses)
# OPENAQ_BASE_URL=https://api.openaq.org/v3
# OPENAQ_TIMEOUT_MS=8000

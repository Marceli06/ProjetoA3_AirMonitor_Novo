# Copie para .env e preencha. NUNCA versione o .env.
DATABASE_URL=
JWT_SECRET=
# No Render a PORT é definida pela plataforma; 3000 é só o padrão local.
PORT=3000
# Em produção use NODE_ENV=production (restringe o CORS a FRONTEND_URL).
NODE_ENV=development

# URL do frontend autorizada pelo CORS em produção (sem barra no final). Várias, separadas por vírgula.
# Em desenvolvimento, qualquer porta de localhost já é aceita.
FRONTEND_URL=

# Chave da API OpenAQ v3 (https://explore.openaq.org). Enviada somente pelo backend, no header X-API-Key.
OPENAQ_API_KEY=

# Opcionais (valores padrão entre parênteses)
# OPENAQ_BASE_URL=https://api.openaq.org/v3
# OPENAQ_TIMEOUT_MS=8000
